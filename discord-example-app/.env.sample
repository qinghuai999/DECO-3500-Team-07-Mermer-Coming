APP_ID=<YOUR_APP_ID>
DISCORD_TOKEN=<YOUR_BOT_TOKEN>
PUBLIC_KEY=<YOUR_PUBLIC_KEY>
GUILD_ID=1542404404680982550
# Voice channel whose members take part in Trait Picker and Random Pick
GAME_VOICE_CHANNEL_ID=1542404405301878860
# Text channel for the panel; Trait Picker and Random Pick only work from this channel
SOCIAL_TEXT_CHANNEL_ID=1542404405301878856
# Persist fair rotation and interrupted-round recovery (mount /app/data in Docker)
STATE_DIR=./data
# Only for the optional pinned panel (npm run panel); use the same channel as SOCIAL_TEXT_CHANNEL_ID
PANEL_CHANNEL_ID=<YOUR_PANEL_CHANNEL_ID>
# Optional: channel where Excuse Generator posts sent excuses; empty posts where the excuse was opened
RESULT_CHANNEL_ID=
# Optional: printed by npm run panel; reuse to update the exact same message
PANEL_MESSAGE_ID=
